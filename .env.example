# SuperShorts — environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# ── LLM (Ollama or LM Studio) ────────────────────────────────────────────────
# Provider: 'ollama' or 'lmstudio'
LLM_PROVIDER=ollama

# Model to use for all LLM calls. 
# For Ollama: Must be pulled: `ollama pull <model>`
# For LM Studio: Must be loaded in the app.
OLLAMA_MODEL=qwen2.5-coder:3b

# LM Studio Base URL (usually http://localhost:1234/v1)
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# LLM sampling temperature (0.0–1.0; lower = more deterministic)
LLM_TEMPERATURE=0.6

# LLM Tone (educational, viral, brainrot, etc.)
LLM_TONE=educational

# ── YouTube Uploader (Selenium / Firefox) ───────────────────────────────────
# Visibility: 1=Public, 2=Unlisted, 3=Private (default: 1)
YT_VISIBILITY=1

# Path to a persistent Firefox profile already logged into YouTube Studio.
# On macOS the default is ~/Library/Application Support/Firefox/Profiles/youtube_uploader
# On Linux / Docker you MUST set this explicitly.
# FIREFOX_PROFILE_PATH=/home/user/.mozilla/firefox/youtube_uploader

# GeckoDriver port (default: random; override for Docker fixed-port setups)
GECKODRIVER_PORT=4444

# ── Pexels B-Roll ────────────────────────────────────────────────────────────
# Get a free API key at https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Video Rendering ──────────────────────────────────────────────────────────
# Output FPS. Lower values speed up rendering (min 12).
VIDEO_FPS=24

# Render threads passed to MoviePy/ffmpeg.
VIDEO_THREADS=2

# Force low-memory mode (smaller output resolution, shorter fade).
# Auto-enabled on Apple Silicon Macs. Set to "true" on resource-limited hosts.
LOW_MEMORY_MODE=false

# Force 1080p even in low-memory mode.
RENDER_HD=false

# ── Custom Assets ─────────────────────────────────────────────────────────────
# Override default background music (absolute path to mp3).
# CUSTOM_MUSIC=/path/to/music.mp3

# Override default background image (absolute path to image).
# CUSTOM_BG=/path/to/background.jpg

# Override default character image for RotGen mode.
# CUSTOM_CHAR=/path/to/character.png

# ── Branding ─────────────────────────────────────────────────────────────────
YOUR_NAME=SuperShorts

# ── Dashboard ────────────────────────────────────────────────────────────────
# Port for the Flask dashboard (default: 5050).
PORT=5050

# ── Topic Overrides (non-interactive / headless / CI) ────────────────────────
# Set any of these to skip interactive prompts in that mode.
VIRAL_TOPIC=
PACKAGE_TOPIC=
CLIPPER_URL=
TUTORIAL_TOPIC=
TCM_TOPIC=
TCM_EXTRA=
TCM_COUNT=3
TCM_USE_EXISTING=y

# ── Clipper ──────────────────────────────────────────────────────────────────
# Seconds to wait between consecutive clip uploads (0 = no wait; 30 default).
UPLOAD_COOLDOWN_S=30
